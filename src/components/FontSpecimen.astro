---
// Temporary: renders one sample page in a given sans + mono pair for the
// Phase 2 font comparison. Delete with src/pages/fonts/ once a family is chosen.
import { Font } from "astro:assets";
import { Code } from "astro:components";

interface Props {
  family: string;
  other: { name: string; href: string };
  sans: "--font-plex-sans" | "--font-geist-sans";
  mono: "--font-plex-mono" | "--font-geist-mono";
}

const { family, other, sans, mono } = Astro.props;

const sample = `// Every figure comes from a deterministic tool, never the model.
export async function monthlySavings(income: number, spend: number) {
  const surplus = income - spend;
  return { surplus, rate: surplus / income };
}`;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <meta name="robots" content="noindex" />
    <title>{family} · font comparison</title>
    <Font cssVariable={sans} preload />
    <Font cssVariable={mono} preload />
  </head>
  <body style={`--sans: var(${sans}); --mono: var(${mono});`}>
    <p class="banner mono">
      Font comparison: <strong>{family}</strong> ·
      <a href={other.href}>switch to {other.name}</a>
    </p>

    <header class="site-header">
      <a class="mono name" href="/">
        daryl lim
      </a>
      <nav class="mono" aria-label="Main">
        <a href="/" aria-current="page">
          home
        </a>
        <a href="/blog/">blog</a>
        <a href="/projects/">projects</a>
        <a href="/resume/">resume</a>
      </nav>
    </header>

    <main>
      <section>
        <h1 class="mono">
          I build AI that runs on your own machine, and agents that show their
          work.
        </h1>
        <p class="lede">
          Private, on-device AI on Apple Silicon, agent systems built on Deep
          Agents and Claude, and clinical AI that keeps patient data out of the
          audit trail.
        </p>
      </section>

      <section>
        <h2 class="mono">About</h2>
        <p>
          Most of what I build runs locally. On Apple Silicon, MLX makes it
          practical to run speech, document and vision models on a laptop, so
          the data never leaves the machine. Granit puts speech, documents,
          vision, hybrid search and a guard model in one local app.
        </p>
        <p>
          My agent work is about trust: agents that quote their evidence, take
          every number from a deterministic tool, and wait for a human to
          approve the final files. <em>Show the work</em> is the design
          principle, not an afterthought.
        </p>
      </section>

      <section>
        <h2 class="mono">Featured projects</h2>
        <div class="cards">
          <article class="card">
            <p class="mono theme">agents</p>
            <h3 class="mono">financial-planner-agent</h3>
            <p>
              A planning agent where every figure comes from a deterministic
              tool, never the model.
            </p>
            <ul class="tags mono">
              <li>python</li>
              <li>deep-agents</li>
              <li>claude</li>
            </ul>
          </article>
          <article class="card">
            <p class="mono theme">on-device ai</p>
            <h3 class="mono">granite-document-intelligence</h3>
            <p>
              PDF to Markdown and JSON on your own machine, including charts and
              tables.
            </p>
            <ul class="tags mono">
              <li>mlx</li>
              <li>granite</li>
              <li>docling</li>
            </ul>
          </article>
        </div>
      </section>

      <section>
        <h2 class="mono">Latest posts</h2>
        <ul class="posts">
          <li>
            <time class="mono" datetime="2026-11-12">
              2026-11-12
            </time>
            <a href="/blog/">Why I build AI that runs on your own machine</a>
          </li>
          <li>
            <time class="mono" datetime="2026-10-03">
              2026-10-03
            </time>
            <a href="/blog/">Agents that show their work</a>
          </li>
        </ul>
      </section>

      <section>
        <h2 class="mono">Code</h2>
        <p>
          Inline code such as <code>monthlySavings()</code> sits in body text;
          blocks use Shiki:
        </p>
        <Code code={sample} lang="ts" theme="github-light" />
      </section>

      <section>
        <h2 class="mono">Weights and figures</h2>
        <p class="weights">
          <span style="font-weight: 400">Regular 400</span>
          <span style="font-weight: 500">Medium 500</span>
          <span style="font-weight: 600">Semibold 600</span>
          <span style="font-weight: 700">Bold 700</span>
        </p>
        <p class="mono">0123456789 Il1| O0 {"{}"} [] () =&gt; != === -&gt;</p>
      </section>
    </main>

    <footer class="mono">
      <a href="https://github.com/darylalim">github</a>
      <a href="https://www.linkedin.com/in/daryl-lim-862a815">linkedin</a>
      <a href="/rss.xml">rss</a>
    </footer>
  </body>
</html>

<style>
  :global(body) {
    margin: 0 auto;
    max-width: 44rem;
    padding: 0 1.25rem 3rem;
    font-family: var(--sans);
    font-size: 1.0625rem;
    line-height: 1.65;
    color: #1c1c1e;
    background: #fdfdfc;
  }
  .mono,
  :global(code),
  :global(pre) {
    font-family: var(--mono);
  }
  a {
    color: inherit;
    text-underline-offset: 0.2em;
  }
  .banner {
    margin: 0 -1.25rem;
    padding: 0.5rem 1.25rem;
    font-size: 0.8125rem;
    background: #fff4c2;
  }
  .site-header {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 1.5rem 0;
  }
  .name {
    font-weight: 600;
    text-decoration: none;
  }
  nav {
    display: flex;
    gap: 1.25rem;
    font-size: 0.9375rem;
  }
  nav a {
    text-decoration: none;
  }
  nav a[aria-current="page"] {
    text-decoration: underline;
  }
  h1 {
    font-size: clamp(1.625rem, 4vw, 2.125rem);
    line-height: 1.25;
    font-weight: 600;
    letter-spacing: -0.01em;
    margin: 1.5rem 0 1rem;
  }
  h2 {
    font-size: 1.125rem;
    font-weight: 600;
    margin: 3rem 0 0.75rem;
  }
  h3 {
    font-size: 1rem;
    font-weight: 600;
    margin: 0.25rem 0 0.5rem;
  }
  .lede {
    font-size: 1.1875rem;
    color: #48484a;
  }
  .cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
    gap: 1rem;
  }
  .card {
    border: 1px solid #e3e3e0;
    border-radius: 6px;
    padding: 1rem 1.125rem;
  }
  .card p {
    margin: 0 0 0.75rem;
  }
  .theme,
  time {
    font-size: 0.8125rem;
    color: #6c6c70;
  }
  .tags,
  .posts {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
    font-size: 0.75rem;
  }
  .tags li {
    padding: 0.125rem 0.5rem;
    border-radius: 999px;
    background: #f0f0ed;
  }
  .posts li {
    display: flex;
    flex-wrap: wrap;
    gap: 0 1rem;
    padding: 0.375rem 0;
  }
  :global(code) {
    font-size: 0.9em;
  }
  :global(pre) {
    padding: 1rem;
    border: 1px solid #e3e3e0;
    border-radius: 6px;
    font-size: 0.875rem;
    line-height: 1.55;
  }
  .weights {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
  }
  footer {
    display: flex;
    gap: 1.25rem;
    margin-top: 4rem;
    padding-top: 1.5rem;
    border-top: 1px solid #e3e3e0;
    font-size: 0.875rem;
  }
</style>
