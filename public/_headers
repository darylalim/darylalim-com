# Response headers for Workers static assets: https://developers.cloudflare.com/workers/static-assets/headers/
# Check with `npm run preview` (not `astro dev`, which ignores this file).
#
# Content-Security-Policy here holds only frame-ancestors (clickjacking protection):
# it is ignored in a <meta> CSP, so it must be a header. It restricts nothing else,
# so it can't clash with Astro's per-page <meta> CSP (astro.config.mjs); browsers
# enforce both.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), browsing-topics=()
  Content-Security-Policy: frame-ancestors 'none'

# Hashed file names (CSS, fonts) change whenever the content does, so cache them for good
/_astro/*
  Cache-Control: public, max-age=31536000, immutable
