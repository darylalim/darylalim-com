{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "darylalim-com",
  "compatibility_date": "2026-10-30",
  // Static assets only: no Worker script, so these requests are free
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
  },
  // Custom domain: Cloudflare creates the DNS record and certificate on deploy.
  "routes": [{ "pattern": "darylalim.com", "custom_domain": true }],
  // Wrangler turns workers.dev off by default once `routes` is set; keep it on
  // as a fallback URL (canonical tags already point to darylalim.com)
  "workers_dev": true,
  // Required by `wrangler preview` (PR builds); empty because previews need no separate settings
  "previews": {},
}
